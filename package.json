{
  "name": "selene-lunar-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SELENE — an interactive lunar observatory. The Moon is the interface.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "data": "python3 scripts/build_moon_textures.py && python3 scripts/build_stars.py && python3 scripts/build_earth.py"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
}
